{
  "name": "@origin89/brand",
  "version": "0.4.0",
  "description": "Origin89 identity: colour tokens for both themes, logos, icons, fonts and Buddy at web sizes.",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://origin89.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin89hq/brand.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./brand.json",
    "./brand.json": "./brand.json",
    "./tokens/tailwind.css": "./tokens/tailwind.css",
    "./tokens/themes.css": "./tokens/themes.css",
    "./tokens/palette": "./tokens/palette.mjs",
    "./tokens/colour": "./tokens/colour.mjs",
    "./logos/*": "./logos/*",
    "./icons/*": "./icons/*",
    "./fonts/*": "./fonts/*",
    "./art/*": "./art/*"
  },
  "files": [
    "brand.json",
    "tokens",
    "logos",
    "icons",
    "fonts",
    "art",
    "LICENSE.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node palette/build.mjs && node build.mjs",
    "verify": "node palette/verify.mjs && node verify.mjs",
    "check": "pnpm lint && pnpm build && pnpm verify && pnpm kit",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm check",
    "release:publish": "changeset publish",
    "kit": "node kit.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome ci . --error-on-warnings",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "sharp": "0.35.4",
    "@biomejs/biome": "2.5.13"
  },
  "packageManager": "pnpm@12.3.4"
}
