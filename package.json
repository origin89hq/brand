{
  "name": "@origin89/brand",
  "version": "0.1.2",
  "description": "Origin89 identity: colour tokens for both themes, logos, icons and fonts.",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://origin89.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin89hq/brand.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./brand.json",
    "./brand.json": "./brand.json",
    "./tokens/tailwind.css": "./tokens/tailwind.css",
    "./tokens/themes.css": "./tokens/themes.css",
    "./tokens/palette": "./tokens/palette.mjs",
    "./tokens/colour": "./tokens/colour.mjs",
    "./logos/*": "./logos/*",
    "./icons/*": "./icons/*",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "brand.json",
    "tokens",
    "logos",
    "icons",
    "fonts",
    "LICENSE.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node palette/build.mjs && node build.mjs",
    "verify": "node palette/verify.mjs && node verify.mjs",
    "check": "npm run build && npm run verify && npm run kit",
    "kit": "node kit.mjs"
  }
}
